{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Keep Cargo manifest requirements semver-ranged; Cargo.lock provides reproducibility",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "quiche/octets/datagram-socket are maintained from one SHA-pinned quiche-fast git fork; registry-version cargo update cannot resolve a git ref named after the crate release",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "quiche",
        "octets",
        "datagram-socket"
      ],
      "enabled": false
    }
  ],
  "forkProcessing": "enabled"
}
