{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Keep Cargo manifest requirements semver-ranged; Cargo.lock provides reproducibility",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "Cargo lockfile maintenance ages a fixed snapshot before merge",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null,
      "rebaseWhen": "never",
      "platformAutomerge": true,
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "forkProcessing": "enabled"
}
